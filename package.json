{
  "name": "dsh-tailnet-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Reach a loopback-bound DeepSeek Harness from your own Tailscale devices, gated on the identity tailscaled stamps. Dependency-free plugin; binds loopback only.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "verify": "node verify.mjs all",
    "grant": "node grant-access.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tailscale",
    "remote-access"
  ],
  "optionalDependencies": {
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
